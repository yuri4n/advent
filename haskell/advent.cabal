cabal-version: 2.4
name: advent
version: 0.1.0.0
synopsis: Advent of Code solutions and a small shared runner
license: BSD-3-Clause
license-file: LICENSE
author: yurianthedev
maintainer: me@yurian.land
build-type: Simple
extra-source-files: README.md

common defaults
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
      base >=4.14 && <5
    , array
    , bytestring
    , text
    , containers
    , directory
    , filepath
    , deepseq
    , megaparsec >=9 && <10
    , split >=0.2 && <0.3

library
  import: defaults
  hs-source-dirs: src
  exposed-modules:
      AOC
      AOC.Input
      AOC.Parsing
      AOC.Registry
      Year2021.Day04
      Year2021.Day05
      Year2021.Day06
      Year2021.Day09
      -- aoc:modules

executable advent-exe
  import: defaults
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: advent
  ghc-options: -threaded -rtsopts

test-suite advent-test
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends: advent
